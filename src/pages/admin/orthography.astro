---
/* Orthography (/admin/orthography) — was orthography.html. Normalises how a
   matn is written, without touching what it says: the rules are in
   src/shared/orthography.ts, the page logic in src/client/admin/orthography.ts. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ALL_POEMS } from '../../poems/index.ts';

const none = ALL_POEMS.length === 0;
---
<AdminLayout title="Orthography" back>
<div class="card">
  <h1>Orthography</h1>
  <p class="sub">Normalises how a matn is written, without touching what it says. It works on the
  stored text, so any correction already made to a bayt is carried through. Nothing is sent until you
  press Apply, and running it twice does nothing the second time. Single bayts are edited
  in the <a href="/admin/editor">Bayt Editor</a>.</p>

  {none ? (
    <div class="msg warn" id="empty">No matn is registered yet, so there is nothing to normalise. To add one, give it an
      entry in <code>src/poems/registry.ts</code> (its id, titles and number of abyāt) and deploy; then bring its text in
      with <a href="/admin/import">Import a matn</a>.</div>
  ) : (
  <>
  <div id="gate">
    <label class="field" for="pw">Password</label>
    <input type="password" id="pw" autocomplete="current-password" placeholder="Admin password">
    <button class="btn-main" id="unlock">Unlock</button>
    <div class="msg err" id="gateMsg"></div>
  </div>

  <div id="main" class="hidden">
    <div class="passes" id="passes"></div>

    <div class="bar">
      <select id="poem" aria-label="Matn"></select>
      <span class="count" id="count"></span>
      <button class="act go" id="apply">Apply</button>
      <button class="act" id="refresh">Refresh</button>
    </div>
    <div class="msg" id="msg"></div>
    <div id="leftAlone" class="left hidden"></div>
    <div class="prev hidden" id="prevWrap">
      <table><thead><tr><th>Bayt</th><th>As stored</th><th>After</th></tr></thead><tbody id="rows"></tbody></table>
    </div>
    <div class="log" id="log"></div>
  </div>
  </>
  )}
</div>

<style is:global>
  @font-face{font-family:'Scheherazade New';font-weight:400;font-display:swap;src:url("/fonts/ScheherazadeNew.woff2") format("woff2")}
  :root{--madder:#8a4447; --madder-deep:#5e2c30; --cream:#faf6ec; --edge:#e8dcc7; --ink:#3a2a2b;
        --ok:#2e6b46; --warn:#9a6a14; --paper:#f7f2e5; --paper-2:#fffdf8; --soft:#7a6a6b}
  *{box-sizing:border-box}
  body{margin:0; background:var(--cream); color:var(--ink);
       font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       min-height:100vh; display:flex; align-items:flex-start; justify-content:center; padding:32px 16px}
  .card{width:100%; max-width:980px; background:#fff; border:1px solid var(--edge); border-radius:18px;
        box-shadow:0 8px 30px rgba(94,44,48,.08); padding:28px 26px}
  h1{margin:0 0 4px; font-size:1.35rem; color:var(--madder-deep)}
  .sub{margin:0 0 20px; color:var(--soft); font-size:.92rem}
  .sub a, .msg a{color:var(--madder)}
  code{background:#f3ece0; padding:1px 5px; border-radius:5px; font-size:.85em}
  label.field{display:block; font-weight:600; font-size:.9rem; margin:16px 0 6px}
  input[type=password], select{width:100%; padding:10px 12px; border:1px solid var(--edge); border-radius:10px;
    font:inherit; background:var(--paper-2); color:var(--ink)}
  input:focus,button:focus-visible,select:focus{outline:2px solid var(--madder); outline-offset:1px}
  button{font:inherit; font-weight:600; border:0; border-radius:999px; padding:11px 22px; cursor:pointer}
  .btn-main{background:var(--madder); color:#fff; width:100%; margin-top:20px}
  .btn-main:disabled{opacity:.5; cursor:default}
  .msg{margin-top:14px; padding:10px 12px; border-radius:10px; font-size:.9rem; display:none}
  .msg.err{display:block; background:#fbeaea; color:#8a2a2a}
  .msg.ok{display:block; background:#e8f3ec; color:var(--ok)}
  .msg.warn{display:block; background:#fdf3e0; color:var(--warn)}
  .hidden{display:none !important}

  .bar{display:flex; flex-wrap:wrap; gap:9px; align-items:center; margin:4px 0 14px;
       padding:13px 15px; background:var(--paper); border:1px solid var(--edge); border-radius:12px}
  .bar select{width:auto; min-width:170px; padding:7px 10px; font-size:.88rem; font-weight:600;
              color:var(--madder-deep); background:var(--paper-2)}
  .bar .count{font-size:.88rem; color:var(--soft); flex:1 1 180px}
  .bar .count b{color:var(--ink)}
  .act{background:var(--paper-2); color:var(--madder-deep); border:1px solid var(--edge); padding:8px 15px; font-size:.86rem}
  .act.go{background:var(--madder); color:#fff; border-color:var(--madder)}
  .act:disabled{opacity:.45; cursor:default}

  .passes{display:flex; flex-wrap:wrap; gap:18px; padding:14px 16px; margin:0 0 14px;
          background:var(--paper-2); border:1px solid var(--edge); border-radius:12px}
  .pass{flex:1 1 380px}
  .pass label{display:flex; gap:9px; align-items:flex-start; cursor:pointer; font-size:.9rem}
  .pass input{margin-top:3px; flex:0 0 auto}
  .pass b{color:var(--madder-deep)}
  .pass span.why{display:block; color:var(--soft); font-size:.84rem; margin-top:3px}
  .ar{font-family:'Scheherazade New',serif; font-size:1.15rem; direction:rtl}

  table{width:100%; border-collapse:collapse; font-size:.9rem}
  th{text-align:left; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:var(--soft);
     font-weight:700; padding:0 8px 8px; border-bottom:1px solid var(--edge)}
  td{padding:8px; border-bottom:1px solid #f0e8da; vertical-align:middle}
  tr:last-child td{border-bottom:0}
  td.n{font-variant-numeric:tabular-nums; color:var(--soft); width:42px}
  td.was{direction:rtl; text-align:right; font-family:'Scheherazade New',serif; font-size:1.12rem; color:var(--soft)}
  td.now{direction:rtl; text-align:right; font-family:'Scheherazade New',serif; font-size:1.18rem}
  .prev{max-height:460px; overflow:auto; border:1px solid var(--edge); border-radius:12px; background:var(--paper-2)}
  .prev table{font-size:.88rem}
  .prev th{position:sticky; top:0; background:var(--paper); z-index:1; padding:8px}
  .left{margin-top:14px; padding:12px 15px; background:#fdf3e0; border:1px solid #ecd9ae; border-radius:12px; font-size:.87rem}
  .left b{color:var(--warn)}
  .left .w{font-family:'Scheherazade New',serif; font-size:1.15rem; direction:rtl; display:inline-block; margin:0 6px}
  /* one heading per chapter: kept to a few lines, so the preview below stays in reach */
  .left .heads{margin-top:6px; max-height:132px; overflow:auto}
  .log{margin-top:16px; font-size:.82rem; color:var(--soft); max-height:160px; overflow:auto;
       background:var(--paper); border:1px solid var(--edge); border-radius:10px; padding:11px 13px; display:none}
  .log.on{display:block}
</style>
<script>import '../../client/admin/orthography.ts';</script>
</AdminLayout>
