---
/* /lectures — the Shaykh's lessons, lectures and khuṭbahs, newest first, from
   src/lectures/registry.ts. Until the first one is added the page shows the
   section's "being gathered" card (src/config/sections.ts). Audio and video
   files play here, loaded only when played; a YouTube lecture opens on
   YouTube; a written one opens on its own page, /lectures/<id>. Styled like
   the guide (it is reached the same way, from Home), with its own cards in
   lectures.css. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.ts';
import { sectionById } from '../config/sections.ts';
import { LECTURES, hasArabic, lectureDate, lectureHref, lectureKind } from '../lectures/index.ts';
import { LECTURE_TEXTS } from '../../content/lectures/index.ts';
import { poemHref } from '../client/page.ts';
import { POEMS } from '../poems/index.ts';
import '../styles/guide.css';
import '../styles/lectures.css';
import '../styles/theme.css';

const s = sectionById('lectures');
const eyebrow = `al-Asl · ${SITE.collection.en}`;
const matnName = (id?: string) => (id ? POEMS.find((p) => p.id === id)?.shortEn : undefined);
/* One compact card per lecture, so a long list stays easy to scan: the
   title with its Arabic, one line of facts, two lines of description (one
   on a phone). A written one is a link as a whole. */
const langOf = (id: string) => (LECTURE_TEXTS[id] ? (hasArabic(LECTURE_TEXTS[id]!) ? 'Arabic & English' : 'English') : '');
const items = LECTURES.map((l) => ({
  l,
  meta: [lectureKind(l), lectureDate(l.date), l.series, l.place, l.minutes ? `${l.minutes} min` : '', l.written ? langOf(l.id) : '']
    .filter(Boolean).join(' · '),
  matn: matnName(l.matn),
}));
---
<BaseLayout title={s.en} description={`${s.lead} ${SITE.appName}.`}>
<div class="gbar"><div class="gbar-inner">
  <a class="gback" href="/#lectures"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>Home</a>
  <span class="t">{s.en}</span>
</div></div>

<header class="gh">
  <div class="eyebrow">{eyebrow}</div>
  <div class="lec-ar" lang="ar" dir="rtl">{s.ar}</div>
  <h1>{s.en}</h1>
  <p>{s.lead}</p>
  {items.length > 0 && <div class="hint">{items.length} {items.length === 1 ? 'lecture' : 'lectures'} · newest first</div>}
</header>

<div class="wrap">
  {items.length > 0 ? (
    <ol class="lec-cards">
      {items.map(({ l, meta, matn }) => (
        <li class={`lec-card${l.written ? ' is-link' : ''}`} id={l.id}>
          <div class="lc-head">
            <h2 class="lc-t">{l.written ? <a class="lc-link" href={lectureHref(l)}>{l.title}</a> : l.title}</h2>
            {l.titleAr && <span class="lc-ar" lang="ar" dir="rtl">{l.titleAr}</span>}
          </div>
          {meta && <div class="lc-meta">{meta}</div>}
          {l.description && <p class="lc-d">{l.description}</p>}
          {l.media?.kind === 'audio' && <audio class="lc-media" controls preload="none" src={l.media.url}></audio>}
          {l.media?.kind === 'video' && <video class="lc-media" controls preload="none" playsinline src={l.media.url}></video>}
          {(l.media?.kind === 'youtube' || (matn && l.matn)) && (
            <div class="lc-acts">
              {l.media?.kind === 'youtube' && <a class="lc-btn" href={l.media.url} target="_blank" rel="noopener">Watch on YouTube ↗</a>}
              {matn && l.matn && <a class="lc-btn lc-btn-q" href={poemHref(l.matn)}>Read {matn}</a>}
            </div>
          )}
          {l.written && <span class="lc-go" aria-hidden="true">›</span>}
        </li>
      ))}
    </ol>
  ) : (
    <div class="lec-empty">
      <div class="prep-emblem" role="img" aria-hidden="true"></div>
      <div class="lbl">In preparation</div>
      <h2>{s.empty.title}</h2>
      <p>{s.empty.text}</p>
      <a class="lc-btn lc-btn-q" href="/">Read his poems meanwhile</a>
    </div>
  )}
</div>

<footer class="gf">{SITE.org.name} · <a href="/">Home</a> · <a href="/guide">User Guide</a></footer>
<script>import '../client/entries/common.ts';</script>
</BaseLayout>
