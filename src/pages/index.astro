---
/* Home — the collection's landing page and, in the installed app, its home
   screen (src/client/app-shell.ts swaps the hero for an app bar and adds the
   bottom tabs). Its sections (src/config/sections.ts: the Shaykh's poems,
   his explanations, his lectures) sit behind one switch, so only one list
   shows at a time; a section with nothing published yet shows a calm "being
   prepared" card. The lists are built here from the registries; progress,
   bookmarks and "Continue" are filled in on the device by src/client/home.ts,
   which also runs the switch. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Brandbar from '../components/Brandbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site.ts';
import { listedPoems, poemHref } from '../client/page.ts';
import { LECTURES_PATH, SECTIONS } from '../config/sections.ts';
import { LECTURES, lectureDate, lectureHref, lectureKind } from '../lectures/index.ts';
import { bootSplash, inlineBoot } from '../client/boot.ts';
import { runSplash } from '../client/splash.ts';
import '../styles/home.css';
import '../styles/theme.css';

const poems = listedPoems();
const count = poems.length;
const abyat = poems.reduce((s, p) => s + p.verses, 0);
const collection = SITE.collection.en.replace(/^The /, '');
const orgHost = SITE.org.url.replace(/^https?:\/\//, '').replace(/\/$/, '');

/* "Six Texts, One Path", counted from the section's own list. */
const WORDS = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const headingFor = (n: number) => (n === 1 ? 'One Text to Begin' : `${WORDS[n] ?? n} Texts, One Path`);

/* One panel per section. The lectures panel previews the newest few and
   links to /lectures, so it never grows into a second long list. */
const LECTURE_PREVIEW = 3;
const panels = SECTIONS.map((s) => {
  const list = s.id === 'lectures' ? [] : listedPoems(s.id);
  return {
    s,
    count: s.id === 'lectures' ? LECTURES.length : list.length,
    rows: list.map((p, i) => ({
      p,
      ord: i + 1,
      meta: [p.author?.name, `${p.verses} abyāt`, p.subject].filter(Boolean).join(' · '),
    })),
  };
});
const lectures = LECTURES.slice(0, LECTURE_PREVIEW);
---
<BaseLayout boot={[bootSplash]}>
<link slot="head" rel="preload" as="image" href="/brand/emblem.png">
<a id="top"></a>
<div id="boot" aria-hidden="true"><div class="boot-wrap"><canvas id="bootfx"></canvas><i class="boot-star"></i></div></div>
<script is:inline set:html={inlineBoot(runSplash)}></script>
<Brandbar />

<header class="hero">
  <div class="hero-inner">
    <div class="eyebrow">{SITE.collection.eyebrow}</div>
    <h1 class="ar">{SITE.collection.ar}</h1>
    <div class="romantitle">{SITE.collection.en}</div>
    <div class="subtitle">{SITE.collection.description}</div>
    <div class="rule"><i></i><b>۞</b><i></i></div>
    <div class="meta-chips">
      {count > 0 ? (
        <>
          <span class="chip"><b>{count}</b> {count === 1 ? 'matn' : 'mutūn'}</span>
          <span class="chip"><b>{abyat}</b> abyāt</span>
          <span class="chip">Read &amp; memorize</span>
        </>
      ) : (
        <span class="chip">Collection in preparation</span>
      )}
    </div>
  </div>
</header>

<section class="section home-main">
  <div class="app-banner" aria-hidden="true">
    <div class="ab-ar">{SITE.collection.ar}</div>
    <div class="ab-en">{SITE.collection.en}</div>
    <div class="ab-rule"><i></i><b>۞</b><i></i></div>
  </div>
  <div id="contWrap" aria-live="polite"></div>
  <div id="statsWrap" aria-label="Your study statistics"></div>
  <div id="bmWrap"></div>

  <div class="sec-switch" role="tablist" aria-label="Sections">
    {panels.map(({ s, count: n }, i) => (
      <button type="button" role="tab" class="sec-tab" id={`tab-${s.id}`} data-sec={s.id}
        aria-controls={`sec-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="st-ar" lang="ar" dir="rtl"><span class="st-long">{s.ar}</span><span class="st-short">{s.arShort}</span></span>
        <span class="st-en"><span class="st-long">{s.en}</span><span class="st-short">{s.short}</span></span>
        <span class={`st-n${n ? '' : ' soon'}`}>{n || 'Soon'}</span>
      </button>
    ))}
  </div>

  {panels.map(({ s, rows }, i) => (
    <div class="sec-panel" id={`sec-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} data-sec={s.id} hidden={i !== 0}>
      {s.id !== 'lectures' && rows.length > 0 && (
        <>
          <div class="sec-head">
            <div class="lbl">{s.en}</div>
            <h2>{headingFor(rows.length)}</h2>
            <p>{s.lead} Open one to read it — or go straight into Memorize mode.</p>
          </div>
          <div class="matn-list">
            {rows.map(({ p, ord, meta }) => (
              <div class={`matn-row m-${p.accent}`} data-poem={p.id} data-total={p.verses}>
                <a class="mr-plate" href={poemHref(p.id)} aria-label={`Open ${p.titleEn}`}>
                  <span class="mr-emblem" role="img" aria-hidden="true"><span class="ord">{ord}</span></span>
                  <span class="mr-ar">{p.shortAr}</span>
                </a>
                <div class="mr-body">
                  <a class="mr-en" href={poemHref(p.id)}>{p.titleEn}</a>
                  <span class="mr-meta">{meta}</span>
                  <span class="mr-prog" hidden><span class="bar"><i></i></span><span class="pct"></span></span>
                  <span class="mr-goal" hidden></span>
                  <span class="mr-acts">
                    <a class="mr-btn mr-read" href={poemHref(p.id, { mode: 'read' })}>Read</a>
                    <a class="mr-btn mr-mz" href={poemHref(p.id, { mode: 'memorize' })}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4 2 9l10 5 10-5-10-5z"/><path d="M5 11.2V16c0 1.6 3.1 3 7 3s7-1.4 7-3v-4.8"/></svg>Memorize</a>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
      {s.id === 'lectures' && lectures.length > 0 && (
        <>
          <div class="sec-head">
            <div class="lbl">{s.en}</div>
            <h2>{LECTURES.length === 1 ? 'The Latest Lecture' : 'The Latest Lectures'}</h2>
            <p>{s.lead}</p>
          </div>
          <div class="lec-list">
            {lectures.map((l) => (
              <a class="lec-row" href={lectureHref(l)}>
                {l.titleAr && <span class="lr-ar" lang="ar" dir="rtl">{l.titleAr}</span>}
                <span class="lr-en">{l.title}</span>
                <span class="lr-meta">{[lectureKind(l), l.series, l.place, lectureDate(l.date), l.minutes ? `${l.minutes} min` : ''].filter(Boolean).join(' · ')}</span>
              </a>
            ))}
          </div>
          <div class="sec-more"><a href={LECTURES_PATH}>{LECTURES.length > LECTURE_PREVIEW ? `All ${LECTURES.length} lectures →` : 'The Lectures page →'}</a></div>
        </>
      )}
      {(s.id === 'lectures' ? lectures.length === 0 : rows.length === 0) && (
        <div class="prep">
          <div class="prep-card">
            <div class="prep-emblem" role="img" aria-hidden="true"></div>
            <div class="lbl">In preparation</div>
            <h3>{s.empty.title}</h3>
            <p>{s.empty.text}</p>
          </div>
        </div>
      )}
    </div>
  ))}
  <div class="guide-link"><a href="/guide">📖 New here? Read the User Guide →</a></div>
</section>

<section class="section" id="texts">
  <div class="prose" style="text-align:center">
    <p>A <b>matn</b> (plural <b>mutūn</b>) is a foundational source text, set down in didactic verse or in prose, in which scholars distilled the essentials of a science so that it could be studied, transmitted, and often committed to memory. Each text in this collection is presented chapter by chapter and bayt by bayt, with its meaning, so that it can be read, understood and learned by heart.</p>
  </div>
</section>

<section class="ayah" aria-label="Sūrat Ibrāhīm, verse 24">
  <div class="ayah-card">
    <svg class="ayah-sprout" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 13.2c0-3.1 2.5-5.6 5.6-5.6C17.6 10.7 15.1 13.2 12 13.2Z" fill="currentColor" opacity=".9"/><path d="M12 11.4C12 8.3 9.5 5.8 6.4 5.8 6.4 8.9 8.9 11.4 12 11.4Z" fill="currentColor" opacity=".9"/><path d="M8.5 22h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    <div class="ayah-ar">أَلَمْ تَرَ كَيْفَ ضَرَبَ ٱللَّهُ مَثَلًا كَلِمَةً طَيِّبَةً كَشَجَرَةٍ طَيِّبَةٍ <span class="root">أَصْلُهَا</span> ثَابِتٌ وَفَرْعُهَا فِى ٱلسَّمَآءِ</div>
    <div class="ayah-en">“Do you not see how Allah compares a good word to a good tree? Its root is firm and its branches reach the sky.”</div>
    <div class="ayah-ref">Sūrat Ibrāhīm · 14 : 24</div>
    <div class="ayah-tie"><b>al-Asl</b>, <span class="ar">الأَصْل</span>, “the root.” A good word, firmly rooted and flourishing upward, the spirit in which these mutūn are offered.</div>
  </div>
</section>

<SiteFooter credit={`The al-Asl ${collection}`} showStores />
<div class="print-only print-footer">{orgHost}&nbsp;&nbsp;·&nbsp;&nbsp;{SITE.org.name}&nbsp;·&nbsp;{collection}</div>

<script>import '../client/entries/home.ts';</script>
</BaseLayout>
